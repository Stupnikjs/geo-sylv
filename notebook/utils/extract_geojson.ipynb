   "source": [
    "import geopandas as gpd \n",
    "\n",
    "df = gpd.read_file(\"../../data/parcelles/gironde/gironde.geojson\")\n",
    "df[\"area\"] = df.to_crs(epsg=2154).area / 10_000\n",
    "df = df.sort_values(\"area\")\n",
    "bigest = df.iloc[[-3]].to_file(\"../../data/parcelles/gironde/pins_2.geojson\", driver=\"GeoJSON\")"
   ]
  }
 ],
